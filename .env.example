# The local launcher creates an ephemeral IPC secret automatically.
# No OpenAI API key, GitHub PAT, or separate runtime token is required.

# Optional read-only public preview. This mode loads only committed JSON from
# public/atlas and does not call D1/API routes.
NEXT_PUBLIC_ATLAS_DATA_MODE=api

# Optional local runtime tuning.
ATLAS_RUNTIME_POLL_MS=2000
ATLAS_RUNTIME_STATUS_MS=15000
ATLAS_RUNTIME_LEASE_MS=90000
ATLAS_CODEX_TIMEOUT_MS=180000
ATLAS_GITHUB_TIMEOUT_MS=120000
ATLAS_CODEX_MAX_INPUT_BYTES=256000

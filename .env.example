# Optional dashboard mutation protection. Graph and dashboard reads stay public.
# Enable only behind a trusted OAuth proxy that injects one of the supported
# identity headers documented in README.md.
ATLAS_WRITE_ACCESS=public

# Atlas Codex Connector. Local development on localhost works without a token.
# Hosting must set the same high-entropy application token on the web app and
# the Connector. This is not an OpenAI API key and is never sent to Codex.
ATLAS_CONNECTOR_TOKEN=
ATLAS_BASE_URL=http://localhost:3000
ATLAS_CONNECTOR_ID=

# Optional Connector tuning.
ATLAS_CONNECTOR_POLL_MS=2000
ATLAS_CONNECTOR_HEARTBEAT_MS=15000
ATLAS_CONNECTOR_LEASE_MS=90000
ATLAS_CODEX_TIMEOUT_MS=180000
ATLAS_CODEX_MAX_INPUT_BYTES=256000
ATLAS_CONNECTOR_MAX_BACKOFF_MS=30000
ATLAS_CODEX_MODEL=
ATLAS_CODEX_PATH=
ATLAS_CODEX_KEEP_SESSIONS=false

# The local launcher creates an ephemeral IPC secret automatically and binds
# the integrated web/runtime process to 127.0.0.1. No OpenAI API key, GitHub
# PAT, or separate runtime token is required.

# Default single-user mode. Omitting this value has the same effect.
ATLAS_EXPOSURE_MODE=local

# The integrated local app reads D1 through same-origin Atlas routes.
NEXT_PUBLIC_ATLAS_DATA_MODE=api

# Remote access is opt-in and must sit behind a trusted OAuth reverse proxy.
# The proxy must remove client-supplied identity headers before injecting its
# own verified identity. Never expose the vinext port directly.
# ATLAS_EXPOSURE_MODE=proxy
# ATLAS_APP_ORIGIN=https://atlas.example.com
# ATLAS_WRITE_ACCESS=authenticated

# The public Vercel target does not use these values. `npm run build:vercel`
# embeds only verified public/atlas JSON and creates no Function/API/DB runtime.

# Optional local runtime tuning.
ATLAS_RUNTIME_POLL_MS=2000
ATLAS_RUNTIME_STATUS_MS=15000
ATLAS_RUNTIME_LEASE_MS=90000
ATLAS_CODEX_TIMEOUT_MS=180000
ATLAS_GITHUB_TIMEOUT_MS=120000
ATLAS_CODEX_MAX_INPUT_BYTES=256000

{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run connector:build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .connector-dist",
    "connector:build": "tsc -p connector/tsconfig.json",
    "connector:start": "npm run connector:build && node .connector-dist/connector/main.js",
    "connector:once": "npm run connector:build && node .connector-dist/connector/main.js --once",
    "connector:batch": "npm run connector:build && node .connector-dist/connector/main.js --batch --enrichment-only --stop-when-idle",
    "connector:dry-run": "npm run connector:build && node .connector-dist/connector/main.js --batch --max-jobs=0 --enrichment-only --stop-when-idle",
    "connector:smoke": "npm run connector:build && node .connector-dist/connector/smoke.js",
    "github:preview-all": "node scripts/preview-all-github-repositories.mjs",
    "github:collect-all": "node scripts/collect-all-github-markdown.mjs",
    "github:audit-all": "node scripts/audit-github-full-collection.mjs --source-only",
    "github:analyze-corpus": "node scripts/analyze-github-corpus.mjs",
    "graph:reprocess": "node scripts/reprocess-local-graph.mjs",
    "graph:audit": "node scripts/audit-local-graph-runtime.mjs",
    "db:generate": "drizzle-kit generate",
    "verify:oauth": "node scripts/verify-oauth-proxy.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.146.0",
    "@types/three": "^0.185.3",
    "d3-force-3d": "^3.0.6",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
